<Window x:Class="Konyvek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Könyvek" Height="550" Width="900">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1.6*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Vertical" Margin="10">
            <Button Content="Könyvek betöltése" Height="35" Margin="10" Click="betoltes"/>
            <Button Content="Hány könyv van?" Height="35" Margin="10" Click="darab"/>
            <Button Content="Melyik a leghosszabb könyv?" Height="35" Margin="10" Click="leghosszabb"/>
            <Button Content="Átlagos oldalszám" Height="35" Margin="10" Click="atlag"/>
            <Button Content="Csak elérhető könyvek" Height="35" Margin="10" Click="csakElerheto"/>
            <Button Content="Csak címek listája" Height="35" Margin="10" Click="csakCimek"/>
            <Button Content="Rendezés szerző szerint" Height="35" Margin="10" Click="rendezes"/>
            <ProgressBar x:Name="folyamat" Height="26" Minimum="0" Maximum="5"/>
        </StackPanel>

        <DataGrid x:Name="dataGrid" Grid.Column="1"/>
    </Grid>
</Window>
